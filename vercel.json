{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node generate-static.js",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/tr/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": { "eq": "TR" } }],
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/zh/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": { "inc": ["CN", "HK", "MO", "TW"] } }],
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/ar/",
      "has": [{ "type": "header", "key": "x-vercel-ip-country", "value": { "inc": ["AE", "SA", "QA", "KW", "BH", "OM", "EG", "JO", "LB", "IQ", "SY", "YE", "PS", "DZ", "MA", "TN", "LY", "SD", "MR", "SO", "DJ", "KM", "TD"] } }],
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/post/:slug/",
      "destination": "/en/blog/:slug/",
      "permanent": true
    },
    {
      "source": "/igainvestment/",
      "destination": "/en/turkish-citizenship-by-investment/",
      "permanent": true
    },
    {
      "source": "/igaturkishcitizenshipbyinvestment/",
      "destination": "/en/turkish-citizenship-by-investment-lawyer/",
      "permanent": true
    },
    {
      "source": "/igalawpracticeareas/",
      "destination": "/en/services/",
      "permanent": true
    },
    {
      "source": "/igalawblog/",
      "destination": "/en/blog/",
      "permanent": true
    },
    {
      "source": "/map/",
      "destination": "/en/contact/",
      "permanent": true
    },
    {
      "source": "/igalawworkpermit/",
      "destination": "/en/igalawworkpermit/",
      "permanent": true
    },
    {
      "source": "/igalawcorporatelaw/",
      "destination": "/en/igalawcorporatelaw/",
      "permanent": true
    },
    {
      "source": "/igalawlegalconsultancy/",
      "destination": "/en/igalawlegalconsultancy/",
      "permanent": true
    },
    {
      "source": "/igalawlitigation/",
      "destination": "/en/igalawlitigation/",
      "permanent": true
    },
    {
      "source": "/igalawresidencepermit/",
      "destination": "/en/igalawresidencepermit/",
      "permanent": true
    },
    {
      "source": "/igalawrealestateduediligence/",
      "destination": "/en/igalawrealestateduediligence/",
      "permanent": true
    },
    {
      "source": "/igalawdocumentation/",
      "destination": "/en/igalawdocumentation/",
      "permanent": true
    }
  ],
  "outputDirectory": "dist"
}
